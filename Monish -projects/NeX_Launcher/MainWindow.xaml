                                                        <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Column="0" BorderBrush="White" BorderThickness="0,0,1,0" Opacity="0.1"/>
                                                    <Border Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,0" Opacity="0.1"/>
                                                    <Border Grid.Row="0" BorderBrush="White" BorderThickness="0,0,0,1" Opacity="0.1"/>
                                                    <Border Grid.Row="1" BorderBrush="White" BorderThickness="0,0,0,1" Opacity="0.1"/>
                                                </Grid>
                                                
                                                <!-- Mock Camera Video animation -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE114;" FontFamily="Segoe MDL2 Assets" Foreground="#60CDFF" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                                                    <TextBlock Text="LIVE HD FEED ACTIVE (EMULATED)" Foreground="#60CDFF" FontSize="11" FontFamily="Consolas" Margin="0,10,0,0" Opacity="0.5"/>
                                                </StackPanel>

                                                <!-- Recording indicator -->
                                                <Border x:Name="CameraRecHUD" Background="#CC000000" CornerRadius="6" Padding="8,4" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
