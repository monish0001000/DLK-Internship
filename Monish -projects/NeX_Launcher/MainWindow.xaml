                                            </Grid>
                                        </Border>

                                        <!-- Files ListView Grid -->
                                        <ListView x:Name="FileListView" Grid.Row="2" Background="#11FFFFFF" BorderBrush="#1C1E1E" BorderThickness="1" MouseDoubleClick="FileListView_MouseDoubleClick">
