                                                 <Button Style="{StaticResource AccentButtonStyle}" Content="CAPTURE" Click="CameraShutter_Click" Width="100" Height="36" Margin="12,0,0,0"/>
                                             </StackPanel>
                                             <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                 <TextBlock Text="Captured snaps:" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                 <Border Width="36" Height="36" CornerRadius="6" Background="#2E3440" BorderBrush="#15FFFFFF" BorderThickness="1">
                                                     <Image x:Name="CameraGalleryThumbnail" Stretch="UniformToFill"/>
                                                 </Border>
                                             </StackPanel>
                                         </Grid>
                                     </Border>
                                </Grid>

                                <!-- MOCK APP 10: Settings App -->
