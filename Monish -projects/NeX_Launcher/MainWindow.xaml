                                                    <Button Style="{StaticResource ModernButtonStyle}" Content="&#xE896; Downloads" FontFamily="Segoe UI" Click="ExplorerDownloads_Click" Margin="0,0,8,0" Padding="10,6" Foreground="#34D399"/>
