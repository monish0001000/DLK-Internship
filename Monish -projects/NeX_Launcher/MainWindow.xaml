                                                        <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="CameraTimerText" Text="REC 00:00" Foreground="White" FontSize="10" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <!-- Shutter Flash Overlay -->
                                                <Border x:Name="CameraFlashOverlay" Background="White" Opacity="0" Visibility="Collapsed"/>
                                                
                                                <!-- Countdown timer Overlay -->
                                                <TextBlock x:Name="CameraCountdownText" Text="3" Foreground="#60CDFF" FontSize="72" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <!-- Controls toolbar -->
                                     <Border Grid.Row="2" Background="#111515" Padding="12,16">
                                         <Grid>
                                             <Grid.ColumnDefinitions>
