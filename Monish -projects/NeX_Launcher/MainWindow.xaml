                                        </Border>

                                        <!-- 3. File List -->
                                        <ListView x:Name="ExplorerListView" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" Margin="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ExplorerListView_MouseDoubleClick" SelectionMode="Single">
                                            <ListView.ContextMenu>
                                                <ContextMenu Background="#1A020617" Foreground="White" BorderBrush="#3300FFFF" BorderThickness="1">
                                                    <MenuItem Header="New Folder" Click="ExplorerNewFolder_Click" Background="#1A020617" Foreground="White"/>
                                                    <MenuItem Header="Rename" Click="ExplorerRename_Click" Background="#1A020617" Foreground="White"/>
                                                    <MenuItem Header="Paste" Click="ExplorerPaste_Click" Background="#1A020617" Foreground="White"/>
                                                    <MenuItem Header="Delete" Click="ExplorerDelete_Click" Background="#1A020617" Foreground="#F87171"/>
                                                    <MenuItem Header="Set as Background" Click="ExplorerSetBackground_Click" Background="#1A020617" Foreground="#60CDFF"/>
                                                </ContextMenu>
                                            </ListView.ContextMenu>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="Margin" Value="2"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1A00FFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#3300FFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>

                                        <!-- 4. Rename Overlay (Hidden by Default) -->
                                        <Grid x:Name="RenameDialogContainer" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="3" Background="#80000000">
                                            <Border Background="#20FFFFFF" BorderBrush="#3000FFFF" BorderThickness="1" CornerRadius="12" Width="360" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Margin="20">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="RENAME ITEM" Foreground="#60CDFF" FontWeight="Bold" FontSize="14" FontFamily="Consolas"/>
                                                    <TextBox x:Name="RenameTextBox" Grid.Row="1" Background="#30000000" Foreground="White" BorderBrush="#60CDFF" BorderThickness="0,0,0,2" FontSize="14" Padding="4" Margin="0,16,0,0"/>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <Button Content="Cancel" Click="RenameCancel_Click" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="0,0,8,0"/>
                                                        <Button Content="Rename" Click="RenameConfirm_Click" Style="{StaticResource AccentButtonStyle}" Width="80"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            
                            <!-- B. SOURCE CODE WORKSPACE VIEW -->
                            <Grid x:Name="CodeViewportGrid" Visibility="Collapsed" Margin="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>  <!-- Solution Explorer -->
                                    <ColumnDefinition Width="*"/>    <!-- Editor Panel -->
                                </Grid.ColumnDefinitions>

                                <!-- Solution Explorer Sidebar -->
                                <Border Grid.Column="0" Background="#1C1E1E" CornerRadius="12,0,0,12" BorderBrush="#15FFFFFF" BorderThickness="1,1,0,1" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Opacity="0.7">
                                            <TextBlock Text="&#xE7C3;" Style="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" Foreground="#60CDFF"/>
                                            <TextBlock Text="SOLUTION EXPLORER" FontSize="10" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Code Files list -->
                                        <ListBox x:Name="SolutionExplorerList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="SolutionExplorerList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE7C3;" Style="{StaticResource FontIcon}" FontSize="14" Foreground="#9CA3AF" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding name}" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- API Documentation Description Box -->
                                        <Border Grid.Row="2" Background="#1A60CDFF" BorderBrush="#3360CDFF" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Bottom">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE12A;" Style="{StaticResource FontIcon}" Foreground="#60CDFF" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="PLATFORM CONTEXT" Foreground="#60CDFF" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <TextBlock x:Name="CodeFileDescText" Text="Description of API parameters." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Editor Canvas Pane -->
                                <Border Grid.Column="1" Background="#0C0E0E" CornerRadius="0,12,12,0" BorderBrush="#15FFFFFF" BorderThickness="0,1,1,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Toolbar -->
                                        <Border Grid.Row="0" Background="#26FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="16,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#1A60CDFF" BorderBrush="#3360CDFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock x:Name="CodeLangLabel" Text="C# / CSHARP" Foreground="#60CDFF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                    </Border>
                                                    <TextBlock x:Name="CodeFileNameLabel" Text="CameraPage.xaml.cs" Foreground="#F3F4F6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Click="CopySourceCode_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource FontIcon}" FontSize="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Copy Code" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Syntax-Colored Document Viewer -->
                                        <FlowDocumentScrollViewer Grid.Row="1" x:Name="CodeDocumentViewer" Background="Transparent" Foreground="LightGray" BorderThickness="0" Padding="16,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>



            <!-- SHUTDOWN DIALOG CONFIRMATION MODAL -->
            <Grid x:Name="ShutdownModal" Visibility="Collapsed" Background="#B3000000">
                <Border Width="360" Height="240" Background="#151717" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Grid.Row="0" Width="44" Height="44" CornerRadius="22" Background="#1AFF0000" BorderBrush="#26FF0000" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource FontIcon}" FontSize="20" Foreground="#F87171"/>
                        </Border>
                        
                        <TextBlock Grid.Row="1" Text="Power Workstation Options" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Choose a power option to control the secure Lumina Kiosk terminal environment." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>

                        <!-- Options grid -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="Restart" Click="PowerRestart_Click" Margin="4,0"/>
                            <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="Lock" Click="PowerLock_Click" Margin="4,0"/>
                            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Background="#7F1D1D" BorderBrush="#F87171" Content="Shutdown" Click="PowerShutdown_Click" Margin="4,0"/>
                        </Grid>
                        
                        <!-- Cancel button inside options stack -->
                        <Button Grid.Row="3" Style="{StaticResource ModernButtonStyle}" Content="Cancel" Click="PowerCancel_Click" HorizontalAlignment="Stretch" Margin="4,8" Grid.RowSpan="2" Height="32" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- POWER OFF / TERMINAL SWEEP OVERLAY SCREEN -->
            <Grid x:Name="PowerOffOverlay" Visibility="Collapsed" Background="Black" Panel.ZIndex="1000">
                <Grid Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="LUMINA HARDENED SYSTEM OS v4.2 [TEARDOWN]" Foreground="#34D399" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                        <Border Height="1" Background="#33FFFFFF" Margin="0,8,0,16"/>
                        <TextBlock x:Name="PowerOffLogs" Foreground="#F3F4F6" FontSize="11" FontFamily="Consolas" LineHeight="20" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource FontIcon}" Foreground="#60CDFF" FontSize="14" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="Restoring pristine sandboxed states in 3 seconds..." Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- LOCKDOWN OVERLAY SCREEN -->
        <Grid x:Name="LockdownOverlay" Visibility="Collapsed" Background="Black" Panel.ZIndex="99999" Grid.RowSpan="2">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="SYSTEM SUSPENDED BY ADMINISTRATOR" Foreground="#FF0000" FontSize="36" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF0000" BlurRadius="20" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Contact Red Team for access." Foreground="#9CA3AF" FontSize="18" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="StartMenuDismissShield" Background="Transparent" Visibility="Collapsed" MouseDown="StartMenuDismiss_Click" Grid.RowSpan="2" />
        
        <Border x:Name="StartMenuOverlay" Grid.Row="1" MaxWidth="350" MaxHeight="500" Background="#E6111111" BorderBrush="#3000FFFF" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60" Visibility="Collapsed" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Pinned" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Button Style="{StaticResource DesktopShortcutStyle}" Tag="edge" Click="AppLauncher_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Globe" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#60CDFF" Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Microsoft Edge" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DesktopShortcutStyle}" Tag="storage" Click="AppLauncher_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Folder" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#FFD700" Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="File Explorer" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DesktopShortcutStyle}" Tag="settings" Click="AppLauncher_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Gear" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#A0A0A0" Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DesktopShortcutStyle}" Tag="notepad" Click="AppLauncher_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Note" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#4DA8DA" Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Notepad" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DesktopShortcutStyle}" Tag="calculator" Click="AppLauncher_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Calc" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#9CA3AF" Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Calculator" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. CUSTOM NEX TASKBAR -->
        <Border Grid.Row="1" Background="#20FFFFFF" BorderBrush="#3000FFFF" BorderThickness="1" CornerRadius="16" Padding="16,8" Margin="0,0,0,24" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Home/Start Button -->
                <Button Grid.Column="0" Click="HomeButton_Click" Style="{StaticResource TaskbarButtonStyle}" Margin="0,0,16,0" ToolTip="Start / Home">
                    <TextBlock Text="∞" FontSize="26" FontFamily="Segoe UI Light" Foreground="#60CDFF" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0" x:Name="InfinityRotator"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InfinityRotator" Storyboard.TargetProperty="Angle" By="360" Duration="0:0:0.5" AutoReverse="False" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InfinityRotator" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Button>
                
                <!-- Active Apps Taskbar -->
                <StackPanel Grid.Column="1" x:Name="ActiveAppsTaskbar" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,16,0"/>
                
                <!-- System Tray -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TaskbarDateText" Foreground="#F3F4F6" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI" FontWeight="Medium"/>
                    <TextBlock x:Name="TaskbarClockText" Foreground="#F3F4F6" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" FontFamily="Segoe UI" FontWeight="Medium"/>
                    <TextBlock Text="&#xE701;" Style="{StaticResource FontIcon}" FontSize="16" Foreground="#F3F4F6" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Wi-Fi Connected"/>
                    <Button Click="TopbarSettings_Click" Style="{StaticResource TaskbarButtonStyle}" ToolTip="Quick Settings">
                        <TextBlock Text="&#xE700;" Style="{StaticResource FontIcon}" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
