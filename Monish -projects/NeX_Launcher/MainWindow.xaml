                                                <DataTemplate>
                                                    <Grid Margin="10" MinHeight="50" Width="480">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                         <TextBlock Grid.Column="0" Text="{Binding IconCode}" Foreground="{Binding IconColor}" Style="{StaticResource FontIcon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Size}" FontSize="10" Foreground="#9CA3AF"/>
                                                                <TextBlock Text="  •  " FontSize="10" Foreground="#9CA3AF"/>
                                                                <TextBlock Text="{Binding DateModified}" FontSize="10" Foreground="#9CA3AF"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Launch" Click="FileLaunch_Click" Tag="{Binding Name}" Style="{StaticResource ModernButtonStyle}" Padding="6,2" FontSize="10"/>
                                                            <Button Content="&#xE74D;" Click="FileDelete_Click" Tag="{Binding Name}" Style="{StaticResource ModernButtonStyle}" FontFamily="Segoe MDL2 Assets" Foreground="#F87171" Width="28" Height="24" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        
