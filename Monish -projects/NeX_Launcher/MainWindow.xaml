                                            <StackPanel Grid.Row="1">
                                                <Button Style="{StaticResource ModernButtonStyle}" Tag="all" Content="📁 All Storage (C:)" Click="FileFilter_Click" HorizontalAlignment="Stretch" Margin="0,2" Padding="10,8"/>
                                                <Button Style="{StaticResource ModernButtonStyle}" Tag="doc" Content="📄 Documents" Click="FileFilter_Click" HorizontalAlignment="Stretch" Margin="0,2" Padding="10,8"/>
                                                <Button Style="{StaticResource ModernButtonStyle}" Tag="sheet" Content="📊 Spreadsheets" Click="FileFilter_Click" HorizontalAlignment="Stretch" Margin="0,2" Padding="10,8"/>
                                                <Button Style="{StaticResource ModernButtonStyle}" Tag="pdf" Content="📖 Manual PDFs" Click="FileFilter_Click" HorizontalAlignment="Stretch" Margin="0,2" Padding="10,8"/>
