<Window x:Class="NeX_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeX Launcher - Enterprise Kiosk Shell" 
        WindowStyle="SingleBorderWindow" 
        WindowState="Normal" 
        Width="1100"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" 
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Background>
        <!-- Deep radial gradient to match the Cyberpunk aesthetic -->
        <RadialGradientBrush Center="0.5, 0.5" GradientOrigin="0.5, 0.5" RadiusX="1.2" RadiusY="1.2">
            <GradientStop Color="#020617" Offset="0"/>
            <GradientStop Color="#000000" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Font Icon Style for Segoe MDL2 Assets -->
        <Style x:Key="FontIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Native Desktop Shortcut Style -->
        <Style x:Key="DesktopShortcutStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FontIcon}">
                    <Setter Property="FontSize" Value="40"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.6" Direction="315" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#50FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#005C7A"/>
            <Setter Property="BorderBrush" Value="#60CDFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007299"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00465C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Taskbar Button Style -->
        <Style x:Key="TaskbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shortcut Text Style (Moved to Window Resources) -->
        <Style TargetType="TextBlock" x:Key="ShortcutTextStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>   <!-- Content Canvas -->
            <RowDefinition Height="Auto"/>  <!-- Taskbar -->
        </Grid.RowDefinitions>

        <!-- 1. CONTENT CANVAS -->
        <Grid Grid.Row="0" x:Name="MainCanvas">
            
            <!-- DESKTOP GRID VIEW (Welcome and Desktop Grid) -->
            <Grid x:Name="DesktopGrid" Visibility="Visible" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Desktop Shortcut Grid -->
                <WrapPanel x:Name="AppLauncherPanel" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" MaxHeight="800">
                    <!-- 1. Microsoft Edge -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="edge">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE774;" Style="{StaticResource FontIcon}" Foreground="#60CDFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Edge" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 2. Settings -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="settings">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE713;" Style="{StaticResource FontIcon}" Foreground="#60CDFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Settings" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 3. File Explorer Sandbox -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="storage">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8D5;" Style="{StaticResource FontIcon}" Foreground="#FCD34D" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Storage" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 4. Excel Sandbox -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="excel">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE82D;" Style="{StaticResource FontIcon}" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="DataSheet" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 5. Word Sandbox -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="word">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8C4;" Style="{StaticResource FontIcon}" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Document" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 6. Paint Sandbox -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="paint">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B9;" Style="{StaticResource FontIcon}" Foreground="#F87171" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="PaintCanvas" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 7. Media Sandbox -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="media">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8C0;" Style="{StaticResource FontIcon}" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Media Hub" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <!-- 8. Browser Sandbox -->
                    <Button Style="{StaticResource DesktopShortcutStyle}" Click="AppLauncher_Click" Tag="webframe">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE774;" Style="{StaticResource FontIcon}" Foreground="#6366F1" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Web Frame" Style="{StaticResource ShortcutTextStyle}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- ACTIVE APP WINDOW CONTAINER FRAME -->
            <Grid x:Name="AppSandboxFrame" Visibility="Collapsed" Margin="40,20">
                <Border Background="#EB151717" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>  <!-- Window Titlebar -->
                            <RowDefinition Height="*"/>   <!-- Active Pane (Live or Code) -->
                        </Grid.RowDefinitions>

                        <!-- Titlebar -->
                        <Border Grid.Row="0" Background="#26FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Info -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" Background="#15FFFFFF" CornerRadius="6" Padding="4" Margin="0,0,10,0">
                                        <TextBlock x:Name="AppFrameIcon" Text="&#xE774;" Style="{StaticResource FontIcon}" FontSize="12" Foreground="#60CDFF"/>
                                    </Border>
                                     <TextBlock x:Name="AppFrameTitle" Text="MICROSOFT EDGE" Foreground="#F3F4F6" FontSize="11" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Live/Code Switcher (Middle) -->
                                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#4D000000" CornerRadius="8" Padding="2" BorderBrush="#15FFFFFF" BorderThickness="1" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LiveAppRadio" Style="{StaticResource {x:Type ToggleButton}}" Content="Live App" IsChecked="True" Checked="ViewMode_Changed" BorderThickness="0" Background="Transparent" Foreground="#9CA3AF" Width="90" Height="26" FontSize="11" FontWeight="SemiBold"/>
                                        <RadioButton x:Name="CodeViewerRadio" Style="{StaticResource {x:Type ToggleButton}}" Content="XAML + C# Code" Checked="ViewMode_Changed" BorderThickness="0" Background="Transparent" Foreground="#9CA3AF" Width="120" Height="26" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Window Controls -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TaskbarButtonStyle}" Width="32" Height="32" Click="AppFrameMinimize_Click" ToolTip="Minimize to Desktop">
                                        <TextBlock Text="&#xE921;" Style="{StaticResource FontIcon}" FontSize="10" Opacity="0.7"/>
                                    </Button>
                                    <Button Style="{StaticResource TaskbarButtonStyle}" Width="32" Height="32" IsEnabled="False" Opacity="0.3" ToolTip="Fixed Layout Maximized">
                                        <TextBlock Text="&#xE922;" Style="{StaticResource FontIcon}" FontSize="10"/>
                                    </Button>
                                    <Button x:Name="AppFrameCloseBtn" Style="{StaticResource TaskbarButtonStyle}" Width="32" Height="32" Click="AppFrameClose_Click" ToolTip="Close Module">
                                        <TextBlock Text="&#xE10A;" Style="{StaticResource FontIcon}" FontSize="10" Foreground="#F87171"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Page Frame Viewport -->
                        <Grid Grid.Row="1">
                            
                            <!-- A. LIVE APPLICATION VIEW -->
                            <Grid x:Name="LiveAppViewport" Visibility="Visible" Margin="20">
                                
                                <!-- MOCK APP 1: Edge Browser -->
                                <Grid x:Name="EdgeSandbox" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1C1E1E" BorderBrush="#282A2A" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="&#xE0C4;" FontFamily="Segoe MDL2 Assets" Foreground="White" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="BrowserBack_Click"/>
                                            <Button Grid.Column="1" Content="&#xE0C5;" FontFamily="Segoe MDL2 Assets" Foreground="White" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="BrowserForward_Click" Margin="4,0,0,0"/>
                                            <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="White" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="BrowserRefresh_Click" Margin="4,0,0,0"/>
                                            <TextBox x:Name="BrowserUrlBar" Grid.Column="3" Text="https://www.google.com" Background="#0C0F0F" Foreground="White" BorderBrush="#60CDFF" VerticalContentAlignment="Center" Margin="10,0" Padding="8,4" KeyDown="BrowserUrl_KeyDown"/>
                                            <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Content="Go" Width="60" Height="32" Click="BrowserGo_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Background="Black" CornerRadius="8" BorderBrush="#282A2A" BorderThickness="1">
                                        <WebBrowser x:Name="MyWebBrowser" Source="https://www.google.com" Navigating="MyWebBrowser_Navigating" LoadCompleted="MyWebBrowser_LoadCompleted"/>
                                    </Border>
                                </Grid>

                                <!-- MOCK APP 2: Word Editor -->
                                <Grid x:Name="WordSandbox" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1C1E1E" CornerRadius="6,6,0,0" Padding="8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ModernButtonStyle}" Width="40" Click="WordBold_Click" ToolTip="Bold">
                                                <TextBlock Text="&#xE19B;" Style="{StaticResource FontIcon}" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource ModernButtonStyle}" Width="40" Click="WordItalic_Click" ToolTip="Italic" Margin="4,0,0,0">
                                                <TextBlock Text="&#xE19D;" Style="{StaticResource FontIcon}" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource ModernButtonStyle}" Width="40" Click="WordUnderline_Click" ToolTip="Underline" Margin="4,0,0,0">
                                                <TextBlock Text="&#xE19A;" Style="{StaticResource FontIcon}" FontSize="12"/>
                                            </Button>
                                            <Separator Width="1" Height="20" Background="#33FFFFFF" Margin="10,0"/>
                                            <Button Style="{StaticResource AccentButtonStyle}" Content="Save Document" Click="WordSave_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <RichTextBox x:Name="WordRichTextBox" Grid.Row="1" Background="#0C0F0F" Foreground="White" BorderBrush="#282A2A" BorderThickness="1" Padding="12" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Grid>

                                <!-- MOCK APP 3: Excel Sheet -->
                                <Grid x:Name="ExcelSandbox" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="fx" Foreground="#34D399" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="ExcelFormulaBar" Grid.Column="1" Height="36" Background="#1C1E1E" Foreground="White" BorderBrush="#34D399" VerticalContentAlignment="Center" Padding="8,2" Text="Select a cell and input formulas (e.g. =SUM(B2:B4))"/>
                                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Background="#10B981" BorderBrush="#34D399" Content="Recalculate Sheet" Click="ExcelCalculate_Click" Margin="10,0,0,0"/>
                                    </Grid>
                                    <DataGrid x:Name="ExcelDataGrid" Grid.Row="1" AutoGenerateColumns="True" Background="#0C0F0F" RowBackground="#0C0F0F" AlternatingRowBackground="#151717" Foreground="White" BorderBrush="#282A2A" GridLinesVisibility="All" SelectionUnit="Cell" ColumnWidth="*" CanUserAddRows="False"/>
                                </Grid>

                                <!-- MOCK APP 4: PDF Reader -->
                                <Grid x:Name="PdfSandbox" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1C1E1E" BorderThickness="0,0,0,1" BorderBrush="#282A2A" Padding="8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Style="{StaticResource ModernButtonStyle}" Content="Previous Page" Click="PdfPrev_Click"/>
                                                <TextBlock x:Name="PdfPageIndicator" Text="Page 1 of 5" Foreground="White" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold"/>
                                                <Button Style="{StaticResource ModernButtonStyle}" Content="Next Page" Click="PdfNext_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Doc: Lumina_Kiosk_Operator_Manual.pdf" Foreground="#F87171" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Background="#0C0F0F" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="PdfContentBlock" Foreground="#E1E8ED" FontSize="14" Margin="30" TextWrapping="Wrap" LineHeight="22" FontFamily="Georgia"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- MOCK APP 5: Notepad -->
                                <Grid x:Name="NotepadSandbox" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1C1E1E" Padding="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ModernButtonStyle}" Content="New Note" Click="NotepadNew_Click"/>
                                            <Button Style="{StaticResource ModernButtonStyle}" Content="Save Plaintext" Click="NotepadSave_Click" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="NotepadEditor" Grid.Row="1" Background="#0C0F0F" Foreground="#F3F4F6" BorderThickness="0" Padding="16" FontSize="14" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                </Grid>

                                <!-- MOCK APP 6: Calculator -->
                                <Grid x:Name="CalculatorSandbox" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Main Panel -->
                                    <Grid Grid.Column="0" Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="CalcFormula" Grid.Row="0" TextAlignment="Right" FontSize="14" Foreground="#9CA3AF" Height="25" Margin="0,0,10,0" FontFamily="Consolas"/>
                                        <TextBlock x:Name="CalcDisplay" Grid.Row="1" Text="0" TextAlignment="Right" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,10,15" FontFamily="Consolas"/>
                                        <Grid Grid.Row="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <!-- R0 -->
                                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="CE" Click="CalcCE_Click" Margin="2" Background="#267F1D1D" Foreground="#F87171"/>
                                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="C" Click="CalcC_Click" Margin="2"/>
                                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="DEL" Click="CalcDel_Click" Margin="2"/>
                                            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="÷" Click="CalcOp_Click" Margin="2"/>
                                            <!-- R1 -->
                                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="7" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="8" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="9" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="×" Click="CalcOp_Click" Margin="2"/>
                                            <!-- R2 -->
                                            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="4" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="5" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="6" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="-" Click="CalcOp_Click" Margin="2"/>
                                            <!-- R3 -->
                                            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="1" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="2" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="3" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="+" Click="CalcOp_Click" Margin="2"/>
                                            <!-- R4 -->
                                            <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Content="±" Click="CalcNeg_Click" Margin="2"/>
                                            <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="0" Click="CalcNum_Click" Margin="2" Background="#11FFFFFF"/>
                                            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="." Click="CalcDot_Click" Margin="2"/>
                                            <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="=" Click="CalcEqual_Click" Margin="2" Background="#60CDFF" Foreground="#003548"/>
                                        </Grid>
                                    </Grid>

                                    <!-- History Panel -->
