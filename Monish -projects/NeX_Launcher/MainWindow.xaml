                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Upper Control Bar -->
                                    <Border Grid.Row="0" Background="#111515" BorderBrush="#1F2424" BorderThickness="0,0,0,1" Padding="12">
                                        <Grid>
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                                <TextBlock Text="WINDOWS CAMERA CAPTURE UTILITY" FontSize="11" FontWeight="Bold" Foreground="#60CDFF" FontFamily="Consolas"/>
                                                <TextBlock Text="Lumina Integrated HD Optical Driver v4.2" FontSize="9" Foreground="#9CA3AF" Margin="0,2,0,0"/>
